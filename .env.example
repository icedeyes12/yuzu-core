# ============================================================
# Yuzu Companion — Environment Variables
# Copy this file to .env and fill in your values.
# .env is in .gitignore — NEVER commit your actual secrets.
# ============================================================

# ── PostgreSQL ─────────────────────────────────────────────
PGHOST=<SET_IN_ENV>
PGPORT=<SET_IN_ENV>
PGDATABASE=<SET_IN_ENV>
PGUSER=<SET_IN_ENV>
PGPASSWORD=<SET_IN_ENV>

# ── AI Providers ───────────────────────────────────────────
CEREBRAS_API_KEY=<SET_IN_ENV>
CHUTES_API_KEY=<SET_IN_ENV>
OPENROUTER_API_KEY=<SET_IN_ENV>

# ── Encryption ────────────────────────────────────────────
ENCRYPTION_KEY=<SET_IN_ENV>

# ── OAuth2 ────────────────────────────────────────────────
# Canonical path: /api/v1/auth/callback.
# Register each origin below at the OAuth provider, exact scheme/host/port.
OAUTH_GOOGLE_CLIENT_ID=<SET_IN_ENV>
OAUTH_GOOGLE_CLIENT_SECRET=<SET_IN_ENV>
OAUTH_GOOGLE_REDIRECT_URI=https://companion.yuzuki.space/api/v1/auth/callback
OAUTH_GITHUB_CLIENT_ID=<SET_IN_ENV>
OAUTH_GITHUB_CLIENT_SECRET=<SET_IN_ENV>
OAUTH_GITHUB_REDIRECT_URI=https://companion.yuzuki.space/api/v1/auth/callback

# Optional comma-separated allowlist for local/Tailnet OAuth origins.
# Add the actual Tailnet IP/port used by this deployment.
OAUTH_REDIRECT_ORIGINS=https://companion.yuzuki.space,http://localhost:5000,http://127.0.0.1:5000,http://100.64.0.10:5000

# Shared auth
APP_BASE_URL=https://companion.yuzuki.space
SESSION_SECRET=<SET_IN_ENV>
