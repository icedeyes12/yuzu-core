# ============================================================
# Yuzu Companion — Environment Variables
# Copy this file to .env and fill in your values.
# .env is in .gitignore — NEVER commit your actual secrets.
# ============================================================

# ── PostgreSQL ─────────────────────────────────────────────
# Connection details. Both PG* and DB_* aliases are accepted.
PGHOST=<SET_IN_ENV>
PGPORT=5432
PGDATABASE=<SET_IN_ENV>
PGUSER=<SET_IN_ENV>
PGPASSWORD=<SET_IN_ENV>

# ── Auth & Session ─────────────────────────────────────────
# Random secret for session signing. Generate:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=<SET_IN_ENV>

# Base URL of the app (used for OAuth redirect URIs)
APP_BASE_URL=http://localhost:5000

# ── OAuth2 (optional — only needed if OAuth login is enabled) ──
# Google OIDC
OAUTH_GOOGLE_CLIENT_ID=<SET_IN_ENV>
OAUTH_GOOGLE_CLIENT_SECRET=<SET_IN_ENV>
OAUTH_GOOGLE_REDIRECT_URI=<SET_IN_ENV>

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=<SET_IN_ENV>
OAUTH_GITHUB_CLIENT_SECRET=<SET_IN_ENV>
OAUTH_GITHUB_REDIRECT_URI=<SET_IN_ENV>

# Optional comma-separated allowlist for local/Tailnet OAuth origins.
# Example: https://example.com,http://localhost:5000,http://127.0.0.1:5000
OAUTH_REDIRECT_ORIGINS=<SET_IN_ENV>

# ── Runtime (optional — sane defaults shown) ───────────────
LOG_LEVEL=INFO
TRUSTED_HOSTS=127.0.0.1,localhost
COOKIE_SECURE=true

# Termux only — path to bash (e.g. /data/data/com.termux/files/usr/bin/bash)
TERMUX_BASH=<SET_IN_ENV>

# ── CLI (optional) ─────────────────────────────────────────
YUZU_BACKEND_URL=http://localhost:5000
YUZU_CLI_HISTORY=~/.yuzu_history

# ── Metrics (optional) ────────────────────────────────────
YUZU_METRICS_ENABLED=false

# ── Notes ─────────────────────────────────────────────────
# AI provider API keys (Chutes, OpenRouter, Cerebras, etc.) are NOT set here.
# They are supplied per-request via the BYOK (Bring Your Own Key) flow —
# entered in the UI, stored in browser localStorage (under user_${userId}_api_keys),
# and sent per request via the X-BYOK-Config header. API keys must never persist
# server-side. No env var needed.
#
# Message encryption key is stored in encryption.key (binary file, auto-generated
# on first run). Do NOT set ENCRYPTION_KEY here — it is not read from env.
# Back up encryption.key if you have encrypted messages in the DB.
